# cfdoh environment template. Copy to deploy/.env and adjust.
# Every variable is optional; defaults live in the config module.
# Full reference: see README or the F-022 requirement table.

# --- upstream ---
# UPSTREAMS=https://cloudflare-dns.com/dns-query,https://dns.google/dns-query,https://dns.quad9.net/dns-query
# ECS_UPSTREAMS=https://cloudflare-dns.com/dns-query,https://dns.google/dns-query,https://dns.quad9.net/dns-query
# UPSTREAM_TIMEOUT_MS=2500
# UPSTREAM_HEDGE_MS=100

# --- answer cache ---
# CACHE_MIN_TTL=30
# CACHE_MAX_TTL=3600
# NEGATIVE_CACHE_MAX_TTL=300
# CACHE_STALE_TTL=86400
# CACHE_PREFETCH_PERCENT=10
# CACHE_MAX_ENTRIES=4096
# MAX_DNS_PACKET_SIZE=65535
# snapshot directory should be a mounted volume in compose
# CACHE_PERSIST_PATH=/var/lib/cfdoh/cache.json

# --- preferred pools & rewrite ---
# CF_REWRITE_ENABLED=true
# CF_PREFERRED_DOMAIN=cf.090227.xyz
# CF_PREFERRED_IPV4=
# CF_PREFERRED_IPV6=
# CF_DROP_AAAA=false
# CF_IPV4_URL=https://www.cloudflare.com/ips-v4
# CF_IPV6_URL=https://www.cloudflare.com/ips-v6

# --- operator pools ---
# ISP_TABLE_URL=
# POOL_FEED_URL=https://cfhub.1molchuan.top/api/v1/pools
# POOL_FEED_INTERVAL_SEC=300
# POOL_FEED_TTL_SEC=1800

# --- ECH ---
# ECH_ENABLED=true
# ECH_SOURCE_DOMAIN=cloudflare-ech.com
# ECH_CONFIG_BASE64=
# ECH_DOMAINS=
# META_ECH_CONFIG_BASE64=
# META_DOMAINS=

# --- special hosts ---
# X_DOMAINS=
# GITHUB_DOMAINS=

# --- rules engine ---
# RULES_JSON=
# RULES_URL=
# DYNAMIC_RULE_HOSTS=
# DYNAMIC_RULES_MAX_BYTES=262144

# --- ECS ---
# ECS_MODE=rules
# ECS_DOMAINS=.cn

# --- HTTP surface ---
# HOST=0.0.0.0
# PORT=8787
# PUBLIC_HOSTNAMES=doh.example.com
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# PATH_ALIASES=/linuxdo
# PPROF_ADDR=

# --- tokens (unset = feature off; /admin/* answers 404 without ADMIN_TOKEN) ---
# ADMIN_TOKEN=
# HUB_TOKEN=
# DOH_ORIGIN_TOKEN=

# --- logging ---
# DEBUG=false
# LOG_QUERIES=false
